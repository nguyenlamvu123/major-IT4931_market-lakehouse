# Helm chart versions used by infra/scripts/up.sh. Bump here only, then `make up`.
# Chosen together: Strimzi 0.45 runs Kafka 3.9.0 (same version as docker compose and the
# version role A's KafkaConnect CR assumes), the spark-operator 2.x chart runs Spark 3.5,
# the Airflow chart 1.15 ships Airflow 2.9.3.
STRIMZI_CHART_VERSION=0.45.0
CERT_MANAGER_CHART_VERSION=v1.15.3
K8SSANDRA_CHART_VERSION=1.20.2
SPARK_OPERATOR_CHART_VERSION=2.0.2
AIRFLOW_CHART_VERSION=1.15.0
KUBE_PROMETHEUS_STACK_CHART_VERSION=61.9.0
