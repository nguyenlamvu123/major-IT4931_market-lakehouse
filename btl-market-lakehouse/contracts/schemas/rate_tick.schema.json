{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://btl-it4931.example/contracts/rate_tick.schema.json",
  "title": "RateTick",
  "type": "object",
  "required": ["day", "tenor", "yield", "source"],
  "properties": {
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tenor": {
      "type": "string",
      "enum": ["2Y", "5Y", "10Y", "30Y"]
    },
    "yield": {
      "type": "number"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "event_time": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": true
}
