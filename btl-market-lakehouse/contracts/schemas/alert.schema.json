{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://btl-it4931.example/contracts/v2/alert.schema.json",
  "title": "MarketAlert",
  "description": "Anomaly written by the speed layer (B) to the alerts topic and market.alerts_by_day. Kafka key = symbol.",
  "type": "object",
  "required": ["alert_id", "symbol", "alert_time", "alert_type", "severity", "price", "message"],
  "properties": {
    "alert_id": {"type": "string", "pattern": "^[0-9a-f]{16}$", "description": "sha1(symbol|alert_time|alert_type)[:16]"},
    "symbol": {"type": "string", "pattern": "^[A-Z0-9.=_-]{2,20}$"},
    "asset_class": {"type": "string", "enum": ["crypto", "equity", "gold", "bond", "fx"]},
    "alert_time": {"type": "string", "description": "ISO-8601 UTC start of the bar that triggered the alert"},
    "day": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "alert_type": {"type": "string", "enum": ["PRICE_SPIKE", "VOLUME_SPIKE", "VOLATILITY_SPIKE"]},
    "severity": {"type": "string", "enum": ["low", "medium", "high"]},
    "price": {"type": "number"},
    "zscore": {"type": ["number", "null"]},
    "volume_zscore": {"type": ["number", "null"]},
    "message": {"type": "string"}
  },
  "additionalProperties": true
}
