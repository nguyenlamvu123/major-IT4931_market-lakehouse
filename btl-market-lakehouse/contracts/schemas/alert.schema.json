{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://btl-it4931.example/contracts/alert.schema.json",
  "title": "MarketAlert",
  "type": "object",
  "required": [
    "alert_id",
    "symbol",
    "alert_time",
    "alert_type",
    "severity",
    "price",
    "message"
  ],
  "properties": {
    "alert_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64
    },
    "symbol": {
      "type": "string",
      "minLength": 2,
      "maxLength": 20
    },
    "alert_time": {
      "type": "string",
      "description": "ISO-8601 timestamp"
    },
    "alert_type": {
      "type": "string",
      "enum": ["PRICE_SPIKE", "VOLUME_SPIKE", "VOLATILITY_SPIKE"]
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "price": {
      "type": "number"
    },
    "zscore": {
      "type": ["number", "null"]
    },
    "volume_zscore": {
      "type": ["number", "null"]
    },
    "message": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
